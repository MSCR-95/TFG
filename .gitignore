# Testing & Quality Tools
# ==============================================================================
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
.nox/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.pdm-python
.pdm-build/

# ==============================================================================
# Project Specific Output & Logs
# ==============================================================================
# Ignore all content but keep the directory via .gitkeep
log/*
!log/.gitkeep
output/*
!output/.gitkeep
tmp/*
!tmp/.gitkeep

# ==============================================================================
# Experiment Artifacts
# ==============================================================================
# Keep only reusable experiment configuration in git.
experiments/*
!experiments/configs/
!experiments/configs/*.yaml

# ==============================================================================
# IDEs / Editors / OS
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~

# Local agent/tool instructions. Keep these machine-specific files out of git.
AGENTS.md
CLAUDE.md
GEMINI.md
.claude/
.gemini/
.agents/

# ==============================================================================
# Notebooks
# ==============================================================================
.ipynb_checkpoints
